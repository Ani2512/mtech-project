# Copy this file to `.env` and fill in your key. `.env` is gitignored.

# Default provider — GPT-5.6 Luna runs on this key.
OPENAI_API_KEY=sk-proj-...

# Optional: only needed if you switch the backend to Anthropic.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Alternative: point at a file that contains only the key.
# OPENAI_API_KEY_FILE=C:\path\to\key.txt