# Copy this file to `.env` and fill in the key for the backend you want.
# `.env` is gitignored.
#
# You may not need to do anything: keys are also picked up from a `.env` one
# directory up (the shared MTech Project folder) and from `llm_project/.env`,
# so a key already configured for a sibling project is found automatically.

# Default backend.
OPENAI_API_KEY=sk-proj-...

# Optional: only needed if you switch the backend to Anthropic in the sidebar.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Alternative: point at a file that contains only the key.
# ANTHROPIC_API_KEY_FILE=C:\path\to\key.txt
